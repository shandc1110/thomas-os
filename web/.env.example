# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored so your secrets never get committed.

# Supabase project URL (safe to expose - shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://yrpjtaqdwieavlhathvo.supabase.co

# Supabase publishable / anon key (safe to expose - shipped to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tVIYXFaEoPU8ghYK-fePEg_RzDxrMIM

# Thomas OS — active tenant slug (defaults to chosen-by-chloe)
THOMAS_TENANT_SLUG=chosen-by-chloe

# Admin login uses Supabase Auth (email + password).
# Create admin users in Supabase -> Authentication -> Users -> Add user.

# Supabase service_role key (SECRET - server-side only, never expose to the browser).
# Required by /api/orders and the image upload script.
# Get it from Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Order confirmation emails (Resend - https://resend.com)
# Without these, orders still work but no email is sent.
RESEND_API_KEY=your-resend-api-key
# Example: Chosen by Chloe <orders@chosenbychloe.com>
# For testing before your domain is verified, Resend may allow:
# Chosen by Chloe <onboarding@resend.dev>
ORDER_EMAIL_FROM=Chosen by Chloe <onboarding@resend.dev>
# CC on every customer order confirmation (comma-separated for multiple)
ORDER_EMAIL_CC=dongchen@chosenbychloe.com

# Shopify Admin API (for fulfilment — draft order creation)
# Store subdomain only, e.g. chosenbychloe (from admin.shopify.com/store/HANDLE)
SHOPIFY_STORE=your-store-name
# Dev Dashboard apps (2026+): Client ID + Client secret — app requests short-lived tokens
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
# Legacy only (pre-2026 custom apps): static Admin API token starting with shpat_
# SHOPIFY_ADMIN_TOKEN=shpat_your-admin-api-token
# GraphQL API version (defaults to 2025-01 if omitted)
SHOPIFY_API_VERSION=2025-01

# Stripe (card payments at checkout — https://dashboard.stripe.com)
# Secret key from Developers -> API keys (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret after adding endpoint POST /api/stripe/webhook
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Public site URL for Stripe redirect (production)
# NEXT_PUBLIC_SITE_URL=https://chosen-by-chloe-order-portal.vercel.app
